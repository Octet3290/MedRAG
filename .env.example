# ==============================================================================
# MedRAG Environment Configuration Template
# Copy this file to `.env` and fill in your actual values.
# NEVER commit the actual `.env` file to version control!
# ==============================================================================

# Application & Environment
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="MedRAG - AI Knowledge Assistant"
API_V1_PREFIX="/api/v1"

# Security & Authentication (Generate using: `openssl rand -hex 32`)
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# Database (Neon PostgreSQL connection string)
# Format: postgresql+psycopg://<user>:<password>@<neon-host>/<database>?sslmode=require
DATABASE_URL=postgresql+psycopg://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# CORS (Frontend origins allowed to call the backend)
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# AI Model Provider Configuration
# Supported providers: openai, google, mock
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_API_KEY=your-embedding-api-key-here

LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your-llm-api-key-here

# Document Ingestion & Storage
MAX_UPLOAD_SIZE_BYTES=10485760 # 10 MB limit
UPLOAD_DIR=storage/uploads
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=50
